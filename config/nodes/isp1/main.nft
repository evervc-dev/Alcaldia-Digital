# isp1: CGNAT de las sedes con pool de IP públicas (una por sede): los kits solo pueden iniciar conexiones salientes
flush ruleset
table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100;
    ip saddr 100.64.1.0/30 oifname != "eth3" oifname != "eth4" snat to 203.0.113.251   # sede 1
    ip saddr 100.64.3.0/30 oifname != "eth3" oifname != "eth4" snat to 203.0.113.253   # sede 3
  }
}
