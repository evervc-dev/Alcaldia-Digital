# adm-pc: PC del personal del centro, VLAN 40 (ADMINISTRACION)
# bond0 active-backup: eth0 -> sw-a1 (camino A), eth1 -> sw-a2 (camino B)
# Monitoreo por ARP al gateway (en GNS3 la portadora no cae al apagar el switch remoto, miimon no sirve)
auto bond0
iface bond0 inet static
	pre-up ip link add bond0 type bond 2>/dev/null || true
	pre-up echo active-backup > /sys/class/net/bond0/bonding/mode; echo 200 > /sys/class/net/bond0/bonding/arp_interval; echo +10.10.40.1 > /sys/class/net/bond0/bonding/arp_ip_target
	pre-up ip link set eth0 down; ip link set eth1 down; echo +eth0 > /sys/class/net/bond0/bonding/slaves; echo +eth1 > /sys/class/net/bond0/bonding/slaves
	address 10.10.40.50
	netmask 255.255.255.0
	gateway 10.10.40.1
	up printf 'nameserver 10.10.40.1\nnameserver 1.1.1.1\n' > /etc/resolv.conf
